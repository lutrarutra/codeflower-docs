---
// The agents, from the descriptors the app embeds (src/data/agents.json).
import agents from '../data/agents.json';
import versions from '../data/versions.json';
const runtime: Record<string, string | undefined> = versions.agents;
---

<table>
  <thead>
    <tr><th>Agent</th><th>id</th><th>Sign-in</th><th>Version in the sandbox</th></tr>
  </thead>
  <tbody>
    {
      agents.map((agent) => (
        <tr>
          <td><strong>{agent.name}</strong></td>
          <td><code>{agent.id}</code></td>
          <td>{agent.description}</td>
          <td>{agent.id === 'claude' ? `Agent SDK ${versions.claudeAgentSdk}` : runtime[agent.id] ?? ''}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<h2 id="services">Services each agent reaches</h2>
<p>
  A <a href="/guides/network-isolation/">network-isolated</a> sandbox can always reach its agent's services. Credential
  variables on your computer are never passed into the sandbox.
</p>
<table>
  <thead>
    <tr><th>Agent</th><th>Hosts</th><th>Credential variables</th><th>Cost estimate</th></tr>
  </thead>
  <tbody>
    {
      agents.map((agent) => (
        <tr>
          <td>{agent.name}</td>
          <td>{agent.providerHosts.map((host, i) => <>{i > 0 && ' '}<code>{host}</code></>)}</td>
          <td>{agent.credentialVariables.map((name, i) => <>{i > 0 && ' '}<code>{name}</code></>)}</td>
          <td>{agent.costEstimate ? 'yes' : 'no'}</td>
        </tr>
      ))
    }
  </tbody>
</table>
